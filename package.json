{
  "name": "dsh-mindwrite",
  "version": "0.8.5",
  "description": "导图写作是 DSH 的长文本写作插件，适合论文、研究报告、方案等结构化长文，支持在全文里审阅 AI 改写并导出 Word。",
  "type": "module",
  "main": "./dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "dist/host.js",
    "dist/client.js",
    "dist/style.css",
    "dist/bundled-dependencies.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "mindmap",
    "writing",
    "deepseek-harness",
    "deepseek",
    "long-form-writing",
    "docx",
    "redline"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "format": "prettier --write src \"scripts/*.{mjs,ts}\" package.json tsconfig*.json cordis.patch.yml",
    "format:check": "prettier --check src \"scripts/*.{mjs,ts}\" package.json tsconfig*.json cordis.patch.yml"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@lezer/markdown": "1.8.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "18.3.1",
    "@xmldom/xmldom": "0.8.15",
    "docx": "9.5.1",
    "esbuild": "0.28.2",
    "jszip": "^3.10.1",
    "mammoth": "1.11.0",
    "postcss": "8.5.33",
    "postcss-value-parser": "4.2.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.0",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oOMickey/dsh-mindwrite.git"
  },
  "homepage": "https://github.com/oOMickey/dsh-mindwrite#readme",
  "bugs": {
    "url": "https://github.com/oOMickey/dsh-mindwrite/issues"
  }
}
